
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopDashboards",
  "version": "0.1.1",
  "identifier": "com.csofts.desktopdashboards",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DesktopDashboards",
        "label": "manager",
        "width": 680,
        "height": 560,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../samples/*": "samples/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "cSofts",
    "category": "Utility",
    "shortDescription": "Desktop Dashboard Manager",
    "longDescription": "DesktopDashboards is a Windows desktop application for managing and displaying desktop dashboards.",
    "copyright": "Copyright © 2026 cSofts.com. All rights reserved.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DashingMZA/DesktopDashboards/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxOTA5MEE1NzQ2ODNDMjcKUldRblBHaDBwWkNRUVdIa1pTYzYrc2RaYnBTSk5DSk5aU3V5WHBPRUxuN1JlYVk1aXFjcDVURHIK"
    }
  }
}
